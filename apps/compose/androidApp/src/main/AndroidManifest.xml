<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- speaking a message to Kimono AI instead of typing it -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- To tell whether a Kimono app's own phone app (Immich for Photos, say) is installed, and open it. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <!-- Uploads carry on with the app closed, with a notification saying how far they've got. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Music plays on with the app closed, its controls in the notification and on the lock screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- New versions published on the Portal install over this one. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Prayer: roughly where you are, asked only when you look for places near you. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Prayer's widgets turn over on the minute while the screen is on (never waking the phone); without it, near the minute. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".KimonoApplication"
        android:label="Kimono"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="${cleartext}"
        android:theme="@style/Kimono">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Where the sign-in page sends the browser sheet back to. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kimono" android:host="auth" />
            </intent-filter>
            <!-- Kimono's own addresses open here when the app is installed (vouched for by the portal's assetlinks.json). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.kimonolabs.dev" />
                <data android:path="/code" />
                <data android:path="/notes" />
                <data android:path="/drive" />
                <data android:path="/books" />
                <data android:path="/music" />
                <data android:pathPrefix="/music/" />
                <data android:pathPrefix="/ai/c/" />
                <data android:pathPrefix="/ai/a/" />
                <data android:path="/account" />
                <data android:pathPrefix="/account/" />
                <data android:path="/prayer" />
                <data android:path="/times" />
                <data android:path="/vpn" />
                <data android:pathPrefix="/vpn/" />
            </intent-filter>
            <!-- Kimono in the share sheet: photos, videos and files from any app. -->
            <intent-filter android:label="Kimono">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <service
            android:name=".MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <!-- Files opened from Drive, handed to the app that opens them. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/drive_files" />
        </provider>
        <!-- An update's progress from the installer, and Kimono reopening once it's in. -->
        <receiver android:name=".UpdateReceiver" android:exported="false" />
        <receiver android:name=".UpdatedReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Prayer on the home screen: the next prayer, today's prayers, and a one-line strip. -->
        <receiver android:name=".NextPrayerReceiver" android:exported="true" android:label="@string/prayer_next_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/prayer_next_info" />
        </receiver>
        <receiver android:name=".TodayPrayerReceiver" android:exported="true" android:label="@string/prayer_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/prayer_today_info" />
        </receiver>
        <receiver android:name=".StripPrayerReceiver" android:exported="true" android:label="@string/prayer_strip_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/prayer_strip_info" />
        </receiver>
        <activity
            android:name=".PrayerWidgetConfig"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Kimono">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- The widgets' minute, and the clock or time zone changing under them. -->
        <receiver android:name=".PrayerTicker" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- Kimono Drive in the Files app and every app's open and save pickers. -->
        <provider
            android:name=".KimonoDocuments"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
