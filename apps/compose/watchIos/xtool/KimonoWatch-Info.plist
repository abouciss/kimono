<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Kimono Watch's Info.plist for xtool builds: what ../project.yml generates for Xcode, with build
  settings written out, since xtool doesn't expand $(VARIABLES). Keep the two in step.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Kimono Watch</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- A universal app: iPhone (1) and iPad (2). Without 2, iPadOS runs it in iPhone compatibility mode. -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<!-- iPhone: portrait to browse; the player turns to landscape by itself. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad turns every way; all four are also what Split View, Slide Over and Stage Manager require. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>
	<!-- Plain: the Xcode build's launch colour lives in the asset catalog, which xtool can't compile. -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Picture in picture and AirPlay keep playing with the app away; nothing else does. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.kimono.watch.connect</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kimono-watch</string>
			</array>
		</dict>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Find AirPlay screens and your Kimono at home.</string>
	<!--
	  Unexpanded on purpose: WatchApp.swift sees the "$(" and skips telling Kimono this build's
	  version through the shared keychain group, which needs a paid team's entitlement.
	-->
	<key>KimonoKeychainGroup</key>
	<string>$(AppIdentifierPrefix)app.kimono.shared</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
